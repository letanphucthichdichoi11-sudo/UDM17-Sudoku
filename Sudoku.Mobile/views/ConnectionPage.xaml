<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Sudoku.Mobile.Views.ConnectionPage"
    BackgroundColor="#17131A">

    <Grid Padding="24">

        <VerticalStackLayout
            Spacing="18"
            VerticalOptions="Center">

            <!-- TITLE -->

            <Label
                Text="CONNECTION STATES"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Mobile - Server"
                FontSize="14"
                TextColor="#BDB6C5"
                HorizontalTextAlignment="Center"
                Margin="0,-10,0,20" />


            <!-- CONNECTION CARD -->

            <Border
                BackgroundColor="#211C25"
                Stroke="#403743"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">

                    <!-- STATUS -->

                    <Grid ColumnDefinitions="Auto,*">

                        <Border
                            WidthRequest="42"
                            HeightRequest="42"
                            BackgroundColor="#28222D"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>

                            <Label
                                Text="●"
                                FontSize="18"
                                TextColor="#FFB000"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding Status}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#FFFFFF" />

                            <Label
                                Text="Checking server connection..."
                                FontSize="12"
                                TextColor="#AFA7B5" />

                        </VerticalStackLayout>

                    </Grid>


                    <!-- STATUS MESSAGE -->

                    <Border
                        BackgroundColor="#18141B"
                        Stroke="#38313D"
                        StrokeThickness="1"
                        Padding="14">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="SERVER"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#FFB000" />

                            <Label
                                Text="Sudoku Server"
                                FontSize="15"
                                TextColor="#FFFFFF" />

                            <Label
                                Text="{Binding Status}"
                                FontSize="13"
                                TextColor="#BDB6C5" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- RETRY BUTTON -->

                    <Button
                        Text="CHECK CONNECTION"
                        HeightRequest="52"
                        CornerRadius="26"
                        BackgroundColor="#F4511E"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        Clicked="CheckConnection_Clicked" />

                </VerticalStackLayout>

            </Border>


            <!-- INFORMATION -->

            <Label
                Text="The app will connect to the Sudoku Server before starting a battle."
                FontSize="12"
                TextColor="#8F8796"
                HorizontalTextAlignment="Center"
                Margin="10,5,10,0" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>