<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Sudoku.Mobile.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#17131A">

    <Grid Padding="24">

        <VerticalStackLayout
            Spacing="18"
            VerticalOptions="Center">

            <!-- TITLE -->
            <Label
                Text="CONNECTION STATES"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Mobile - Server"
                FontSize="14"
                TextColor="#BDB6C5"
                HorizontalTextAlignment="Center"/>


            <!-- CONNECTION CARD -->
            <Border
                Padding="18"
                BackgroundColor="#211C25"
                Stroke="#403743"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="SERVER CONNECTION"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"/>

                    <!-- CONNECTING -->
                    <Grid ColumnDefinitions="Auto,*">

                        <Label
                            Text="🔵"
                            FontSize="18"/>

                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="CONNECTING..."
                            FontSize="13"
                            TextColor="#FFFFFF"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- SEARCHING -->
                    <Grid ColumnDefinitions="Auto,*">

                        <Label
                            Text="🟡"
                            FontSize="18"/>

                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="SEARCHING FOR OPPONENT..."
                            FontSize="13"
                            TextColor="#FFFFFF"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- FOUND -->
                    <Grid ColumnDefinitions="Auto,*">

                        <Label
                            Text="🟢"
                            FontSize="18"/>

                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="OPPONENT FOUND!"
                            FontSize="13"
                            TextColor="#FFFFFF"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- RECONNECTING -->
                    <Grid ColumnDefinitions="Auto,*">

                        <Label
                            Text="🔄"
                            FontSize="18"/>

                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="RECONNECTING..."
                            FontSize="13"
                            TextColor="#FFFFFF"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- RESTORED -->
                    <Grid ColumnDefinitions="Auto,*">

                        <Label
                            Text="✅"
                            FontSize="18"/>

                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="CONNECTION RESTORED"
                            FontSize="13"
                            TextColor="#FFFFFF"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- DISCONNECTED -->
                    <Grid ColumnDefinitions="Auto,*">

                        <Label
                            Text="🔴"
                            FontSize="18"/>

                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="OPPONENT DISCONNECTED"
                            FontSize="13"
                            TextColor="#FFFFFF"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- SERVER ERROR -->
                    <Grid ColumnDefinitions="Auto,*">

                        <Label
                            Text="⛔"
                            FontSize="18"/>

                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="SERVER ERROR"
                            FontSize="13"
                            TextColor="#FF655D"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- TIME UP -->
                    <Grid ColumnDefinitions="Auto,*">

                        <Label
                            Text="🟡"
                            FontSize="18"/>

                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="TIME'S UP!"
                            FontSize="13"
                            TextColor="#FFFFFF"
                            VerticalOptions="Center"/>

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- CHECK BUTTON -->
            <Button
                Text="CHECK CONNECTION"
                HeightRequest="52"
                CornerRadius="26"
                BackgroundColor="#FF4A22"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="14"
                Clicked="CheckConnection_Clicked"/>


            <!-- STATUS -->
            <Label
                x:Name="StatusLabel"
                Text="Ready to connect"
                FontSize="12"
                TextColor="#BDB6C5"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>