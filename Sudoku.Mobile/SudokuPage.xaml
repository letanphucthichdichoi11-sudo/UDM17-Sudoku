<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Sudoku.Mobile.SudokuPage"
    Title="Sudoku">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="SUDOKU"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Giải Sudoku"
                FontSize="16"
                HorizontalOptions="Center" />

            <!-- Bàn Sudoku -->
            <Grid
                x:Name="SudokuGrid"
                HeightRequest="360"
                WidthRequest="360"
                RowSpacing="1"
                ColumnSpacing="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            </Grid>

            <!-- Các phím số -->
            <Grid
                RowSpacing="5"
                ColumnSpacing="5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="1"
                    Clicked="OnNumberClicked" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="2"
                    Clicked="OnNumberClicked" />

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="3"
                    Clicked="OnNumberClicked" />

                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    Text="4"
                    Clicked="OnNumberClicked" />

                <Button
                    Grid.Row="0"
                    Grid.Column="4"
                    Text="5"
                    Clicked="OnNumberClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="6"
                    Clicked="OnNumberClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="7"
                    Clicked="OnNumberClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="8"
                    Clicked="OnNumberClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="3"
                    Text="9"
                    Clicked="OnNumberClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="4"
                    Text="Xóa"
                    Clicked="OnClearClicked" />

            </Grid>

            <Button
                Text="Ván mới"
                Clicked="OnNewGameClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>