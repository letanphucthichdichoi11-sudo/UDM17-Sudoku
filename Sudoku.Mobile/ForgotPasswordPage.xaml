<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku.Mobile.ForgotPasswordPage"
             Title="Khôi phục mật khẩu"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F4F6">

    <Grid>
        <BoxView Color="#2b0b98" HeightRequest="200" VerticalOptions="Start" />

        <ScrollView VerticalOptions="Center">
            <Border StrokeShape="RoundRectangle 20" Stroke="Transparent" BackgroundColor="White" Margin="25,40,25,20" Padding="25,30,25,30">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Offset="0,10" Radius="20"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Khôi Phục Mật Khẩu" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#1F2937" Margin="0,0,0,10"/>

                    <VerticalStackLayout x:Name="Step1Layout" Spacing="20">
                        <Label Text="Nhập địa chỉ email đã đăng ký để nhận mã OTP khôi phục an toàn." 
                               TextColor="#6B7280" HorizontalTextAlignment="Center" FontSize="14"/>

                        <Frame Padding="15,0" CornerRadius="12" BorderColor="#E5E7EB" HasShadow="False" BackgroundColor="#F9FAFB" HeightRequest="50">
                            <Entry x:Name="EmailEntry" Placeholder="Nhập Email của bạn" Keyboard="Email" ClearButtonVisibility="WhileEditing" TextColor="#111827"/>
                        </Frame>

                        <Button x:Name="SendOtpBtn" Text="Gửi mã xác minh" Clicked="OnSendOtpClicked" 
                                BackgroundColor="#2b0b98" TextColor="White" CornerRadius="25" HeightRequest="50" FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="Step2Layout" Spacing="15" IsVisible="False">
                        <Label Text="Vui lòng nhập OTP và tạo mật khẩu mới." TextColor="#6B7280" HorizontalTextAlignment="Center" FontSize="14" Margin="0,0,0,10"/>

                        <Frame Padding="15,0" CornerRadius="12" BorderColor="#E5E7EB" HasShadow="False" BackgroundColor="#F9FAFB" HeightRequest="55">
                            <Entry x:Name="OtpEntry" Placeholder="Mã OTP (6 số)" Keyboard="Numeric" MaxLength="6" HorizontalTextAlignment="Center" FontSize="18" FontAttributes="Bold" CharacterSpacing="5" TextColor="#111827"/>
                        </Frame>

                        <Frame Padding="15,0" CornerRadius="12" BorderColor="#E5E7EB" HasShadow="False" BackgroundColor="#F9FAFB" HeightRequest="50">
                            <Entry x:Name="NewPasswordEntry" Placeholder="Mật khẩu mới" IsPassword="True" TextColor="#111827"/>
                        </Frame>

                        <Frame Padding="15,0" CornerRadius="12" BorderColor="#E5E7EB" HasShadow="False" BackgroundColor="#F9FAFB" HeightRequest="50">
                            <Entry x:Name="ConfirmPasswordEntry" Placeholder="Xác nhận mật khẩu mới" IsPassword="True" TextColor="#111827"/>
                        </Frame>

                        <Button x:Name="ResetBtn" Text="Đổi mật khẩu" Clicked="OnResetPasswordClicked" 
                                BackgroundColor="#10B981" TextColor="White" CornerRadius="25" HeightRequest="50" FontAttributes="Bold" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>