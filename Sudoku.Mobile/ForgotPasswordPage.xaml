<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku.Mobile.ForgotPasswordPage"
             Title="Quên mật khẩu"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F0FF">

    <Grid>
        <ScrollView VerticalOptions="Center">
            <!-- Khung lưới chống cắt xén trên Windows -->
            <Grid HorizontalOptions="Center" MaximumWidthRequest="450" MinimumWidthRequest="350">

                <Border StrokeShape="RoundRectangle 30" Stroke="Transparent" BackgroundColor="White" 
                        Margin="0,20,0,20" Padding="20,30,20,30">
                    <Border.Shadow>
                        <Shadow Brush="#7C3AED" Opacity="0.15" Offset="0,15" Radius="25"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">

                        <!-- Header nằm ngang -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" Margin="0,0,0,5">
                            <Image Source="icon_key_box.png" WidthRequest="65" HeightRequest="65" VerticalOptions="Center" Aspect="AspectFit"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Lost your key?" FontSize="22" FontAttributes="Bold" TextColor="#7C3AED"/>
                                <Label Text="No worries! We'll send a rescue code." FontSize="13" TextColor="#9CA3AF"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Ô nhập Rescue Email -->
                        <Border StrokeShape="RoundRectangle 16" Stroke="#8B5CF6" StrokeThickness="2" BackgroundColor="White" WidthRequest="310" HeightRequest="55" Padding="15,0" HorizontalOptions="Center">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="vector.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Margin="0,0,10,0" Aspect="AspectFit"/>
                                <Entry Grid.Column="1" x:Name="EmailEntry" Placeholder="Rescue Email Address" Keyboard="Email" TextColor="#9CA3AF" PlaceholderColor="#A78BFA" BackgroundColor="Transparent" HeightRequest="35" VerticalOptions="Center" HorizontalOptions="Fill" ReturnType="Done" Completed="OnSendOtpClicked"/>
                            </Grid>
                        </Border>

                        <!-- Nút Send OTP (Màu Cyan) -->
                        <Border StrokeShape="RoundRectangle 25" Stroke="Transparent" BackgroundColor="#06B6D4" HeightRequest="55" WidthRequest="310" HorizontalOptions="Center" Margin="0,5,0,5">
                            <Border.Shadow>
                                <Shadow Brush="#0891B2" Opacity="1" Offset="0,6" Radius="0"/>
                            </Border.Shadow>
                            <Button x:Name="SendOtpBtn" Text="Send OTP" Clicked="OnSendOtpClicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="16"/>
                        </Border>

                        <!-- Đường kẻ đứt nét chia cắt (Divider) -->
                        <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="10" Margin="0,10">
                            <Line Stroke="#A78BFA" StrokeThickness="2" StrokeDashArray="3,3" X2="200" VerticalOptions="Center"/>
                            <Image Grid.Column="1" Source="chain.png" WidthRequest="24" HeightRequest="24"/>
                            <Line Grid.Column="2" Stroke="#A78BFA" StrokeThickness="2" StrokeDashArray="3,3" X2="200" VerticalOptions="Center"/>
                        </Grid>

                        <Label Text="Almost there! Enter code &amp; new key:" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#7C3AED" Margin="0,0,0,5"/>

                        <!-- 6 Ô nhập OTP xếp hàng ngang -->
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border StrokeShape="RoundRectangle 12" Stroke="#06B6D4" StrokeThickness="2" BackgroundColor="White" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="Otp1" Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" FontSize="22" FontAttributes="Bold" TextColor="#7C3AED" BackgroundColor="Transparent" HeightRequest="35" VerticalOptions="Center" TextChanged="OnOtpTextChanged" Focused="OnOtpFocused" Unfocused="OnOtpUnfocused"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#06B6D4" StrokeThickness="2" BackgroundColor="White" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="Otp2" Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" FontSize="22" FontAttributes="Bold" TextColor="#7C3AED" BackgroundColor="Transparent" HeightRequest="35" VerticalOptions="Center" TextChanged="OnOtpTextChanged" Focused="OnOtpFocused" Unfocused="OnOtpUnfocused"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#06B6D4" StrokeThickness="2" BackgroundColor="White" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="Otp3" Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" FontSize="22" FontAttributes="Bold" TextColor="#7C3AED" BackgroundColor="Transparent" HeightRequest="35" VerticalOptions="Center" TextChanged="OnOtpTextChanged" Focused="OnOtpFocused" Unfocused="OnOtpUnfocused"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#06B6D4" StrokeThickness="2" BackgroundColor="White" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="Otp4" Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" FontSize="22" FontAttributes="Bold" TextColor="#7C3AED" BackgroundColor="Transparent" HeightRequest="35" VerticalOptions="Center" TextChanged="OnOtpTextChanged" Focused="OnOtpFocused" Unfocused="OnOtpUnfocused"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#06B6D4" StrokeThickness="2" BackgroundColor="White" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="Otp5" Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" FontSize="22" FontAttributes="Bold" TextColor="#7C3AED" BackgroundColor="Transparent" HeightRequest="35" VerticalOptions="Center" TextChanged="OnOtpTextChanged" Focused="OnOtpFocused" Unfocused="OnOtpUnfocused"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#06B6D4" StrokeThickness="2" BackgroundColor="White" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="Otp6" Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" FontSize="22" FontAttributes="Bold" TextColor="#7C3AED" BackgroundColor="Transparent" HeightRequest="35" VerticalOptions="Center" TextChanged="OnOtpTextChanged" Focused="OnOtpFocused" Unfocused="OnOtpUnfocused"/>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Ô nhập New Password -->
                        <Border StrokeShape="RoundRectangle 16" Stroke="#8B5CF6" StrokeThickness="2" BackgroundColor="White" WidthRequest="310" HeightRequest="55" Padding="15,0" HorizontalOptions="Center" Margin="0,5,0,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="lock.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Margin="0,0,10,0" Aspect="AspectFit"/>
                                <Entry Grid.Column="1" x:Name="NewPasswordEntry" Placeholder="New Password" IsPassword="True" TextColor="#9CA3AF" PlaceholderColor="#A78BFA" BackgroundColor="Transparent" HeightRequest="35" VerticalOptions="Center" HorizontalOptions="Fill" ReturnType="Done" Completed="OnResetPasswordClicked"/>
                            </Grid>
                        </Border>

                        <!-- Nút Reset Password (Màu Tím) -->
                        <Border StrokeShape="RoundRectangle 25" Stroke="Transparent" BackgroundColor="#8B5CF6" HeightRequest="55" WidthRequest="310" HorizontalOptions="Center" Margin="0,10,0,0">
                            <Border.Shadow>
                                <Shadow Brush="#6D28D9" Opacity="1" Offset="0,6" Radius="0"/>
                            </Border.Shadow>
                            <Button x:Name="ResetPasswordBtn" Text="Reset Password" Clicked="OnResetPasswordClicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="16"/>
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <!-- Dòng chữ dưới đáy màn hình -->
        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,30">
            <Label Text="Back to security? " TextColor="#8B5CF6" FontAttributes="Bold" />
            <Label Text="Log in!" TextColor="#06B6D4" FontAttributes="Bold">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLoginTapped" />
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>