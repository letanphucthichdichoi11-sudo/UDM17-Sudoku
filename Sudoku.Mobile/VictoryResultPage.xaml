<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Sudoku.Mobile.VictoryResultPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Victory"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F3EEFD">

    <Grid Padding="19,46,19,21" RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="0">
            <Border Padding="12,6" BackgroundColor="White" Stroke="#E9D5FF"
                    StrokeThickness="1" StrokeShape="RoundRectangle 18">
                <Label Text="SUDOKU DUEL 1V1" FontFamily="Nunito"
                       FontSize="10" TextColor="#7C3AED" CharacterSpacing="1.1" />
                <Border.Shadow>
                    <Shadow Brush="#18000000" Offset="0,2" Radius="3" Opacity="0.35" />
                </Border.Shadow>
            </Border>
            <Label Text="VICTORY" Margin="0,13,0,0" HorizontalTextAlignment="Center"
                   FontFamily="Fredoka" FontSize="29" FontAttributes="Bold"
                   TextColor="#7C3AED" CharacterSpacing="-0.3" />
            <Label Text="COMPLETED" Margin="0,0,0,0" HorizontalTextAlignment="Center"
                   FontFamily="Nunito" FontSize="11" FontAttributes="Bold" TextColor="#6D28D9"
                   CharacterSpacing="1.1" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Margin="0,14,0,13" Padding="22,23"
                MaximumWidthRequest="384" VerticalOptions="Center"
                BackgroundColor="White" Stroke="#7C3AED" StrokeThickness="2"
                StrokeShape="RoundRectangle 18">
            <Border.Shadow>
                <Shadow Brush="#177C3AED" Offset="0,12" Radius="28" Opacity="0.5" />
            </Border.Shadow>
            <Grid RowDefinitions="Auto,1,Auto" RowSpacing="19">
                <VerticalStackLayout Grid.Row="0" Spacing="2" HorizontalOptions="Fill">
                    <Label Text="MATCH RESULT" HorizontalTextAlignment="Center"
                           FontFamily="Nunito" FontAttributes="Bold" FontSize="10" TextColor="#6B7280"
                           CharacterSpacing="1.05" />
                    <Label Text="You defeated" HorizontalTextAlignment="Center"
                           FontFamily="Nunito" FontAttributes="Bold" FontSize="14" TextColor="#4C1D95" />
                    <Label x:Name="OpponentNameLabel" HorizontalTextAlignment="Center"
                           FontFamily="Fredoka" FontAttributes="Bold"
                           FontSize="19" TextColor="#7C3AED" />
                </VerticalStackLayout>
                <BoxView Grid.Row="1" HeightRequest="1" Color="#F3EEFD" />
                <Border Grid.Row="2" Padding="12,13" BackgroundColor="#FAF5FF"
                        Stroke="#DDD6FE" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="COMPLETION TIME" HorizontalTextAlignment="Center"
                               FontFamily="Nunito" FontAttributes="Bold"
                               FontSize="10" TextColor="#7C3AED" CharacterSpacing="1" />
                        <Label x:Name="CompletionTimeLabel" HorizontalTextAlignment="Center"
                               FontFamily="Fredoka" FontAttributes="Bold"
                               FontSize="25" TextColor="#0D9488" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Button Grid.Row="2" Text="HOME" HeightRequest="48" MaximumWidthRequest="384"
                HorizontalOptions="Fill" BackgroundColor="#7C3AED" TextColor="White"
                CornerRadius="14" FontFamily="Fredoka" FontAttributes="Bold"
                FontSize="15" CharacterSpacing="1" Clicked="OnHomeClicked">
            <Button.Shadow>
                <Shadow Brush="#477C3AED" Offset="0,8" Radius="20" Opacity="0.65" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
