<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="Sudoku.Mobile.SudokuPage"
 BackgroundColor="#F5F7FA"
 Title="Sudoku Battle">

    
    <Grid
    Padding="16"
    RowDefinitions="Auto,Auto,*,Auto,Auto"
    RowSpacing="12">

        <!-- PLAYER -->
        <Grid
        Grid.Row="0"
        ColumnDefinitions="*,Auto,*"
        ColumnSpacing="10">

            <Border
            Grid.Column="0"
            Padding="10"
            BackgroundColor="White"
            Stroke="#D1D5DB"
            StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="3">
                    <Label
                    Text="YOU"
                    FontAttributes="Bold"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    TextColor="#2563EB" />

                    <Label
                    Text="Player 1"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    TextColor="#374151" />
                </VerticalStackLayout>

            </Border>

            <Label
            Grid.Column="1"
            Text="VS"
            FontAttributes="Bold"
            FontSize="14"
            VerticalOptions="Center"
            TextColor="#9CA3AF" />

            <Border
            Grid.Column="2"
            Padding="10"
            BackgroundColor="White"
            Stroke="#D1D5DB"
            StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="3">
                    <Label
                    Text="OPPONENT"
                    FontAttributes="Bold"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    TextColor="#EF4444" />

                    <Label
                    Text="Player 2"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    TextColor="#374151" />
                </VerticalStackLayout>

            </Border>

        </Grid>


        <!-- TIMER -->
        <HorizontalStackLayout
        Grid.Row="1"
        HorizontalOptions="Center"
        Spacing="6">

            <Label
            Text="TIME"
            FontAttributes="Bold"
            FontSize="14"
            TextColor="#6B7280" />

            <Label
            x:Name="TimerLabel"
            Text="05:00"
            FontAttributes="Bold"
            FontSize="16"
            TextColor="#111827" />

        </HorizontalStackLayout>


        <!-- SUDOKU -->
        <Border
        Grid.Row="2"
        Padding="2"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        BackgroundColor="#111827"
        Stroke="#111827"
        StrokeThickness="2"
        StrokeShape="RoundRectangle 6">

            <Grid
            x:Name="SudokuGrid"
            WidthRequest="360"
            HeightRequest="360"
            RowSpacing="1"
            ColumnSpacing="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            </Grid>

        </Border>


        <!-- NUMBER PAD -->
        <VerticalStackLayout
        Grid.Row="3"
        Spacing="5">

            <Grid
            ColumnDefinitions="*,*,*,*,*"
            ColumnSpacing="5">

                <Button
                Grid.Column="0"
                Text="1"
                Clicked="Number_Clicked"
                HeightRequest="42"
                BackgroundColor="White"
                TextColor="#111827"
                FontSize="18"
                CornerRadius="8" />

                <Button
                Grid.Column="1"
                Text="2"
                Clicked="Number_Clicked"
                HeightRequest="42"
                BackgroundColor="White"
                TextColor="#111827"
                FontSize="18"
                CornerRadius="8" />

                <Button
                Grid.Column="2"
                Text="3"
                Clicked="Number_Clicked"
                HeightRequest="42"
                BackgroundColor="White"
                TextColor="#111827"
                FontSize="18"
                CornerRadius="8" />

                <Button
                Grid.Column="3"
                Text="4"
                Clicked="Number_Clicked"
                HeightRequest="42"
                BackgroundColor="White"
                TextColor="#111827"
                FontSize="18"
                CornerRadius="8" />

                <Button
                Grid.Column="4"
                Text="5"
                Clicked="Number_Clicked"
                HeightRequest="42"
                BackgroundColor="White"
                TextColor="#111827"
                FontSize="18"
                CornerRadius="8" />

            </Grid>

            <Grid
            ColumnDefinitions="*,*,*,*,*"
            ColumnSpacing="5">

                <Button
                Grid.Column="0"
                Text="6"
                Clicked="Number_Clicked"
                HeightRequest="42"
                BackgroundColor="White"
                TextColor="#111827"
                FontSize="18"
                CornerRadius="8" />

                <Button
                Grid.Column="1"
                Text="7"
                Clicked="Number_Clicked"
                HeightRequest="42"
                BackgroundColor="White"
                TextColor="#111827"
                FontSize="18"
                CornerRadius="8" />

                <Button
                Grid.Column="2"
                Text="8"
                Clicked="Number_Clicked"
                HeightRequest="42"
                BackgroundColor="White"
                TextColor="#111827"
                FontSize="18"
                CornerRadius="8" />

                <Button
                Grid.Column="3"
                Text="9"
                Clicked="Number_Clicked"
                HeightRequest="42"
                BackgroundColor="White"
                TextColor="#111827"
                FontSize="18"
                CornerRadius="8" />

                <Button
                Grid.Column="4"
                Text="X"
                Clicked="Clear_Clicked"
                HeightRequest="42"
                BackgroundColor="#FEE2E2"
                TextColor="#DC2626"
                FontAttributes="Bold"
                FontSize="18"
                CornerRadius="8" />

            </Grid>

        </VerticalStackLayout>


        <!-- SUBMIT -->
        <Button
        Grid.Row="4"
        Text="SUBMIT"
        HeightRequest="48"
        CornerRadius="12"
        FontAttributes="Bold"
        FontSize="16"
        BackgroundColor="#2563EB"
        TextColor="White"
        Clicked="SubmitButton_Clicked" />

    </Grid>
    

</>
