<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku.Mobile.LoginPage"
             Title="Đăng nhập"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F0FF">

    <Grid>


        <Image Source="bg_blob.png" HorizontalOptions="Start" VerticalOptions="Start" Margin="-60,-40,0,0" WidthRequest="320" Opacity="0.6" Aspect="AspectFit"/>
        <Image Source="bg_blob22.png" HorizontalOptions="Center" VerticalOptions="End" Margin="80,0,-50,-50" WidthRequest="380" Opacity="0.6" Aspect="AspectFit"/>

        <Image Source="mini_grid.png" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,-25,120" WidthRequest="70" Rotation="-15" Aspect="AspectFit"/>
        <Image Source="mini_grid_1.png" HorizontalOptions="Start" VerticalOptions="End" Margin="30,0,0,80" WidthRequest="55" Rotation="25" Aspect="AspectFit"/>

        <Image Source="confetti.png" HorizontalOptions="Start" VerticalOptions="Center" Margin="45,220,0,0" WidthRequest="15" Aspect="AspectFit"/>
        <Image Source="confetti_1.png" HorizontalOptions="End" VerticalOptions="Start" Margin="0,150,60,0" WidthRequest="20" Aspect="AspectFit"/>
        <Image Source="confetti_2.png" HorizontalOptions="Center" VerticalOptions="End" Margin="-110,0,0,95" WidthRequest="12" Aspect="AspectFit"/>

        <!-- LỚP TRÊN CÙNG: KHUNG ĐĂNG NHẬP (CARD)      -->

        <ScrollView VerticalOptions="Center">
            <Grid HorizontalOptions="Center" MaximumWidthRequest="450" MinimumWidthRequest="350">

                <!-- LỚP DƯỚI: Thẻ màu trắng  -->
                <Border StrokeShape="RoundRectangle 30" Stroke="Transparent" BackgroundColor="White" 
                        Margin="0,45,0,20" Padding="20,50,20,30">
                    <Border.Shadow>
                        <Shadow Brush="#7C3AED" Opacity="0.15" Offset="0,15" Radius="25"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <Label Text="Welcome Back!" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#7C3AED" />
                        <!-- Ô nhập Email -->
                        <Border StrokeShape="RoundRectangle 16" Stroke="#8B5CF6" StrokeThickness="2" BackgroundColor="White" 
        WidthRequest="310" HeightRequest="55" Padding="15,0" HorizontalOptions="Center">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="vector.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Margin="0,0,10,0" Aspect="AspectFit"/>
                                <Entry Grid.Column="1" x:Name="UsernameEntry" Placeholder="Your Game Email" Keyboard="Email" 
               TextColor="#9CA3AF" PlaceholderColor="#A78BFA" BackgroundColor="Transparent" 
               HeightRequest="35" VerticalOptions="Center" HorizontalOptions="Fill"/>
                            </Grid>
                        </Border>

                        <!-- Ô nhập Mật khẩu -->
                        <Border StrokeShape="RoundRectangle 16" Stroke="#8B5CF6" StrokeThickness="2" BackgroundColor="White" 
        WidthRequest="310" HeightRequest="55" Padding="15,0" Margin="0,20,0,0" HorizontalOptions="Center">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="lock.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Margin="0,0,10,0" Aspect="AspectFit"/>

                                <Entry Grid.Column="1" x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" 
               TextColor="#9CA3AF" PlaceholderColor="#A78BFA" BackgroundColor="Transparent" 
               HeightRequest="35" VerticalOptions="Center" HorizontalOptions="Fill"/>
                            </Grid>
                        </Border>
                        <Label Text="Forgot your key?" TextColor="#0891B2" FontAttributes="Bold" HorizontalOptions="End" FontSize="14">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Khung và chữ nút Login -->
                        <Grid Margin="0,10,0,0" HeightRequest="65">
                            <Image Source="bt_3d.png" Aspect="AspectFit" />
                            <Button x:Name="LoginBtn" Text="Login &amp; Play!" Clicked="OnLoginClicked" 
                                    BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="18"/>
                        </Grid>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,25,0,0">
                            <Label Text="New player?" TextColor="#A78BFA" VerticalOptions="Center"/>
                            <Label Text="Join the Fun!" TextColor="#06B6D4" FontAttributes="Bold" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRegisterTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- LỚP TRÊN: Logo tay cầm (mascot_badge) nằm hoàn toàn độc lập, đè lên thẻ trắng -->
                <Image Source="mascot_badge.png" HeightRequest="85" WidthRequest="85" 
                       HorizontalOptions="Center" VerticalOptions="Start" Aspect="AspectFit" />

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>