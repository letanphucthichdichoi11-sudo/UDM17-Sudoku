<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku.Mobile.LoginPage"
             Title="Đăng nhập"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F4F6">

    <Grid>
        <BoxView Color="#2b0b98" HeightRequest="250" VerticalOptions="Start" />

        <ScrollView VerticalOptions="Center">
            <Border StrokeShape="RoundRectangle 20" Stroke="Transparent" BackgroundColor="White" Margin="25,40,25,20" Padding="25,30,25,30">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Offset="0,10" Radius="20"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    <Image Source="logo.png" HeightRequest="90" Margin="0,0,0,10" HorizontalOptions="Center"/>

                    <Label Text="Chào mừng trở lại!" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#1F2937" />
                    <Label Text="Đăng nhập để vào phòng chơi Sudoku" FontSize="14" HorizontalOptions="Center" TextColor="#6B7280" Margin="0,-15,0,10" />

                    <Frame Padding="15,0" CornerRadius="12" BorderColor="#E5E7EB" HasShadow="False" BackgroundColor="#F9FAFB" HeightRequest="50">
                        <Entry x:Name="UsernameEntry" Placeholder="Email hoặc Username" Keyboard="Email" ClearButtonVisibility="WhileEditing" TextColor="#111827" />
                    </Frame>

                    <Frame Padding="15,0" CornerRadius="12" BorderColor="#E5E7EB" HasShadow="False" BackgroundColor="#F9FAFB" HeightRequest="50">
                        <Entry x:Name="PasswordEntry" Placeholder="Mật khẩu" IsPassword="True" ClearButtonVisibility="WhileEditing" TextColor="#111827" />
                    </Frame>

                    <Label Text="Quên mật khẩu?" TextColor="#2b0b98" FontAttributes="Bold" HorizontalOptions="End" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Button x:Name="LoginBtn" Text="Đăng nhập" Clicked="OnLoginClicked" 
                            BackgroundColor="#2b0b98" TextColor="White" CornerRadius="25" HeightRequest="50" FontAttributes="Bold" Margin="0,10,0,0"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,15,0,0">
                        <Label Text="Chưa có tài khoản?" TextColor="#6B7280" VerticalOptions="Center"/>
                        <Label Text="Đăng ký ngay" TextColor="#2b0b98" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>